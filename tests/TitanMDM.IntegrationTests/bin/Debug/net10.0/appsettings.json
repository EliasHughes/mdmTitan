  "EnablePolicyManagement": true,
  "EnableDeviceSynchronization": true,
  "EnableDeviceCommands": true,
  "EnableApplicationManagement": true,
  "EnableKioskManagement": true,
  "EnableComplianceSynchronization": true
},

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
