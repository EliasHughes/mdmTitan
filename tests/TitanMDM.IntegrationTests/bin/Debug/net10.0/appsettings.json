  "CallbackUrl": "",
  "FrontendSuccessUrl": "http://localhost:3020/enrollment?androidEnterprise=connected",
  "FrontendErrorUrl": "http://localhost:3020/enrollment?androidEnterprise=error",
  "BaseUrl": "https://androidmanagement.googleapis.com/v1/",
