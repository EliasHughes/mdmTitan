{
  "Application": {
    "FrontendUrl": "http://localhost:3020"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3020"
    ]
  },

  "Security": {
    "RequireHttps": false
  },

  "SignalR": {
    "EnableDetailedErrors": true
  },

  "EntraLogin": {
    "Enabled": false,
    "FrontendReturnUrl": "http://localhost:3020/login/entra"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },

  "AllowedHosts": "*"
}